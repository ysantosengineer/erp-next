# Portas locais; não inclua segredos neste arquivo.
WEB_PORT=3000
API_PORT=3001
# Em provedores como Render, PORT é injetada automaticamente e tem precedência sobre API_PORT.
# PORT=10000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Em produção, habilite HTTPS e defina AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Defina 1 somente quando a API estiver atrás de um proxy confiável que substitui X-Forwarded-For.
TRUST_PROXY_HOPS=0
POSTGRES_DB=erp_next
POSTGRES_USER=erp_next
POSTGRES_PASSWORD=erp_next_local_only
POSTGRES_PORT=5432
DATABASE_URL="postgresql://erp_next:erp_next_local_only@localhost:5432/erp_next?schema=public"
# Gere valores únicos e seguros para cada ambiente; nunca reutilize estes placeholders em produção.
JWT_ACCESS_SECRET=replace_with_a_secure_random_access_secret_of_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret_of_at_least_32_characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=erp-next-api
JWT_AUDIENCE=erp-next-web
SWAGGER_ENABLED=true
REQUEST_BODY_LIMIT=256kb
# Identificador público do artefato; nunca inclua segredos.
APP_VERSION=development
SEED_ADMIN_EMAIL=admin@erp.local
SEED_ADMIN_PASSWORD=replace_with_a_local_password_of_at_least_12_characters
