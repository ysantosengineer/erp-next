generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SupplierType {
  INDIVIDUAL
  COMPANY
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

model Company {
  id         String          @id @default(uuid()) @db.Uuid
  name       String
  document   String?         @unique
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  users      User[]
  roles      Role[]
  categories Category[]
  units      UnitOfMeasure[]
  suppliers  Supplier[]
  products   Product[]
  customers  Customer[]
  warehouses Warehouse[]
  locations  StockLocation[]
  auditLogs  AuditLog[]
}

model Warehouse {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   String          @db.Uuid
  name        String
  code        String
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  locations   StockLocation[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, isActive])
  @@index([companyId, name])
}

model StockLocation {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  warehouseId String    @db.Uuid
  code        String
  description String?
  zone        String?
  aisle       String?
  rack        String?
  level       String?
  position    String?
  capacity    Decimal?  @db.Decimal(14, 3)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [companyId, warehouseId], references: [companyId, id], onDelete: Restrict)

  @@unique([warehouseId, code])
  @@index([companyId, isActive])
  @@index([warehouseId, isActive])
  @@index([warehouseId, zone])
}

model Customer {
  id          String            @id @default(uuid()) @db.Uuid
  companyId   String            @db.Uuid
  type        CustomerType
  name        String
  tradeName   String?
  document    String
  email       String?
  phone       String?
  creditLimit Decimal           @default(0) @db.Decimal(14, 2)
  notes       String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  addresses   CustomerAddress[]

  @@unique([companyId, document])
  @@index([companyId, isActive, type])
  @@index([companyId, name])
}

model CustomerAddress {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  type       String   @default("MAIN")
  postalCode String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?
  country    String   @default("BR")
  isPrimary  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, isPrimary])
}

model Supplier {
  id          String            @id @default(uuid()) @db.Uuid
  companyId   String            @db.Uuid
  type        SupplierType
  name        String
  tradeName   String?
  document    String
  email       String?
  phone       String?
  contactName String?
  notes       String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  addresses   SupplierAddress[]
  products    Product[]

  @@unique([companyId, document])
  @@index([companyId, isActive, type])
  @@index([companyId, name])
}

model SupplierAddress {
  id         String   @id @default(uuid()) @db.Uuid
  supplierId String   @db.Uuid
  type       String   @default("MAIN")
  postalCode String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?
  country    String   @default("BR")
  isPrimary  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([supplierId, isPrimary])
}

model Category {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  name           String
  normalizedName String
  description    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products       Product[]

  @@unique([companyId, normalizedName])
  @@index([companyId, isActive])
}

model UnitOfMeasure {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  name             String
  normalizedName   String
  symbol           String
  normalizedSymbol String
  description      String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products         Product[]

  @@unique([companyId, normalizedName])
  @@unique([companyId, normalizedSymbol])
  @@index([companyId, isActive])
}

model Product {
  id                String        @id @default(uuid()) @db.Uuid
  companyId         String        @db.Uuid
  categoryId        String        @db.Uuid
  unitId            String        @db.Uuid
  primarySupplierId String?       @db.Uuid
  name              String
  description       String?
  sku               String
  barcode           String?
  costPrice         Decimal       @db.Decimal(14, 2)
  salePrice         Decimal       @db.Decimal(14, 2)
  weight            Decimal?      @db.Decimal(14, 3)
  height            Decimal?      @db.Decimal(14, 3)
  width             Decimal?      @db.Decimal(14, 3)
  length            Decimal?      @db.Decimal(14, 3)
  minimumStock      Decimal       @default(0) @db.Decimal(14, 3)
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category          Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit              UnitOfMeasure @relation(fields: [unitId], references: [id], onDelete: Restrict)
  primarySupplier   Supplier?     @relation(fields: [primarySupplierId], references: [id], onDelete: Restrict)

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId, isActive])
  @@index([companyId, name])
  @@index([categoryId])
  @@index([unitId])
  @@index([primarySupplierId])
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  companyId     String         @db.Uuid
  name          String
  email         String         @unique
  passwordHash  String
  authVersion   Int            @default(1)
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]     @relation("AuditLogActor")
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String           @db.Uuid
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, name])
  @@index([companyId])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  resource    String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@unique([resource, action])
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String?  @db.Uuid
  actorId    String?  @db.Uuid
  entity     String
  entityId   String
  action     String
  before     Json?
  after      Json?
  requestId  String?
  occurredAt DateTime @default(now())
  actor      User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([actorId])
  @@index([entity, entityId])
  @@index([occurredAt])
}
